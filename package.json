{
  "name": "costco-price-matcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "costco": "costco"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src tests package.json tsconfig.json vitest.config.ts eslint.config.js .prettierrc.json",
    "build": "tsc && chmod +x dist/cli.js",
    "probe:live-price": "node --import tsx scripts/live-price-probe.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "fs-ext": "^2.1.1",
    "nodemailer": "^10.0.13",
    "playwright": "^1.62.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-ext": "^2.0.3",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.32.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
